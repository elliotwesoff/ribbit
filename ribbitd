#!/usr/bin/python
"""Keep a Piper voice loaded and speak text sent over a Unix socket.

Protocol, one request per connection:

  Speak: send a line with the length scale (e.g. "1.0", or empty for the
  server's default), then the text, then close the write side. The server plays the audio and closes the
  connection when it has finished. New speech interrupts any current
  speech, and disconnecting before the end stops it.

  Stop: send the line "stop". Whatever is being spoken stops.

Test with:
    printf '1.0\nHello there. This is a test.' | nc -NU "$XDG_RUNTIME_DIR/ribbit.sock"
    printf 'stop\n' | nc -NU "$XDG_RUNTIME_DIR/ribbit.sock"
"""

import argparse
import os
import select
import signal
import socket
import socketserver
import subprocess
import sys
import threading
from typing import Optional

from piper import PiperVoice, SynthesisConfig

DEFAULT_MODEL = "/usr/share/piper-voices/en/en_US/ryan/high/en_US-ryan-high.onnx"
DEFAULT_SOCKET = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "ribbit.sock")


class Playback:
    """One piece of speech playing through aplay, which can be stopped from any thread."""

    def __init__(self, sample_rate: int) -> None:
        self.stopped = threading.Event()
        self.finished = threading.Event()
        self.aplay = subprocess.Popen(
            ["aplay", "-q", "-r", str(sample_rate), "-f", "S16_LE", "-c", "1", "-t", "raw", "-"],
            stdin=subprocess.PIPE,
        )

    def write(self, audio: bytes) -> bool:
        """Queue audio for playback. Returns False once playback has been stopped."""
        if self.stopped.is_set():
            return False
        try:
            self.aplay.stdin.write(audio)
            return True
        except (BrokenPipeError, ValueError):
            return False

    def wait(self) -> None:
        """Wait for queued audio to finish playing, or for a stop."""
        try:
            self.aplay.stdin.close()
        except BrokenPipeError:
            pass
        self.aplay.wait()
        self.finished.set()

    def stop(self) -> None:
        self.stopped.set()
        self.aplay.kill()


class Speaker:
    """Owns the loaded voice and whichever Playback is currently speaking.

    Only one piece of speech plays at a time: starting a new one stops the old.
    """

    def __init__(self, voice: PiperVoice, sentence_silence: float, default_length_scale: float) -> None:
        self.voice = voice
        self.sample_rate = voice.config.sample_rate
        self.silence = bytes(int(self.sample_rate * sentence_silence) * 2)
        self.default_length_scale = default_length_scale
        self.current: Optional[Playback] = None
        self.lock = threading.Lock()

    def warm_up(self) -> None:
        """The first synthesis is slow while ONNX warms up, so get it out of the way."""
        for _ in self.voice.synthesize("Warm up."):
            pass

    def start(self) -> Playback:
        """Stop any current speech and make a new Playback the current one."""
        playback = Playback(self.sample_rate)
        with self.lock:
            if self.current is not None:
                self.current.stop()
            self.current = playback
        return playback

    def play(self, playback: Playback, text: str, length_scale: Optional[float]) -> None:
        """Synthesize text into playback and wait until it has played or been stopped."""
        syn_config = SynthesisConfig(length_scale=length_scale or self.default_length_scale)
        try:
            for i, chunk in enumerate(self.voice.synthesize(text, syn_config)):
                if i > 0 and not playback.write(self.silence):
                    break
                if not playback.write(chunk.audio_int16_bytes):
                    break
        finally:
            playback.wait()
            with self.lock:
                if self.current is playback:
                    self.current = None

    def stop(self) -> None:
        with self.lock:
            if self.current is not None:
                self.current.stop()


def stop_on_hangup(sock: socket.socket, playback: Playback) -> None:
    """Stop playback if the client disconnects before it finishes."""
    poller = select.poll()
    poller.register(sock, select.POLLHUP)
    while not playback.finished.is_set():
        if poller.poll(100):
            playback.stop()
            return


class Handler(socketserver.StreamRequestHandler):
    """Handles one request; see the protocol at the top of this file."""

    server: "Server"

    def handle(self) -> None:
        speaker = self.server.speaker

        first_line = self.rfile.readline().decode("utf-8", errors="replace").strip()
        if first_line == "stop":
            speaker.stop()
            return

        try:
            length_scale: Optional[float] = float(first_line)
        except ValueError:
            length_scale = None
        text = " ".join(self.rfile.read().decode("utf-8", errors="replace").split())
        if not text:
            return

        playback = speaker.start()
        threading.Thread(target=stop_on_hangup, args=(self.connection, playback), daemon=True).start()
        speaker.play(playback, text, length_scale)


class Server(socketserver.ThreadingMixIn, socketserver.UnixStreamServer):
    daemon_threads = True

    def __init__(self, path: str, speaker: Speaker) -> None:
        if os.path.exists(path):
            os.remove(path)
        super().__init__(path, Handler)
        os.chmod(path, 0o600)
        self.speaker = speaker

    def server_close(self) -> None:
        super().server_close()
        self.speaker.stop()
        if os.path.exists(self.server_address):
            os.remove(self.server_address)


def main() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument("-m", "--model", default=DEFAULT_MODEL)
    parser.add_argument("--socket", default=DEFAULT_SOCKET)
    parser.add_argument("--sentence-silence", type=float, default=0.2)
    parser.add_argument(
        "--length-scale",
        type=float,
        help="Default speed for requests that don't set one, lower is faster"
        " (default: the voice's own, usually 1.0)",
    )
    args = parser.parse_args()

    voice = PiperVoice.load(args.model)
    speaker = Speaker(voice, args.sentence_silence, args.length_scale or voice.config.length_scale)
    speaker.warm_up()

    # Exit through server_close() on `kill` as well as Ctrl+C.
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))

    with Server(args.socket, speaker) as server:
        print(f"Voice loaded, listening on {args.socket}", flush=True)
        try:
            server.serve_forever()
        except KeyboardInterrupt:
            pass


if __name__ == "__main__":
    main()
